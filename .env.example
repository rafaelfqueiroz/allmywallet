# Copy to .env and fill in. DV-24: .env is never committed.
# AR-43 / SPEC-003 BR-003-09: on the VPS this file is root-only and injected via
# Docker Compose; in CI the equivalents are GitHub Actions secrets.

# --- database -----------------------------------------------------------------
# Runtime connects as the restricted app role: not the table owner, no BYPASSRLS.
DATABASE_URL=postgresql://allmywallet_app:allmywallet@localhost:5432/allmywallet
# Migrations only. Absent from the running containers by design (ARCHITECTURE §5).
DATABASE_MIGRATION_URL=postgresql://allmywallet_migrator:allmywallet@localhost:5432/allmywallet

POSTGRES_USER=allmywallet_migrator
POSTGRES_PASSWORD=allmywallet
POSTGRES_DB=allmywallet

# --- auth ---------------------------------------------------------------------
# SPEC-001 BR-001-02: scopes are pinned to `openid email profile` in code.
# No password is ever created, transmitted or stored (BR-003-08).
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- observability ------------------------------------------------------------
# AR-48: Sentry must be configured to scrub request bodies, headers and query
# strings. It captures them by default, which would violate BR-004-04 on day one.
SENTRY_DSN=
LOG_LEVEL=info

NODE_ENV=development
