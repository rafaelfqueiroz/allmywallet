# SPEC-021 — the personal migrator env file. TEMPLATE ONLY.
#
# scripts/personal/init.sh copies this to migrator.env beside personal.env,
# OUTSIDE the repository, mode 600 (BR-021-09). It is never a Compose env_file:
# the scripts load it into their own shell to interpolate Postgres' password and
# to pass DATABASE_MIGRATION_URL to the one-off migrator container alone. No
# running container ever holds a credential with DDL rights.

POSTGRES_USER=allmywallet_migrator
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
POSTGRES_DB=allmywallet
PERSONAL_DATABASE_MIGRATION_URL=postgresql://allmywallet_migrator:__POSTGRES_PASSWORD__@postgres:5432/allmywallet
