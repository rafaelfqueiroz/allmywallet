# SPEC-021 — the personal production env file. TEMPLATE ONLY.
#
# scripts/personal/init.sh copies this to $ALLMYWALLET_ENV_FILE
# (default ~/.config/allmywallet/personal.env), OUTSIDE the repository, mode
# 600, with the __PLACEHOLDERS__ replaced by generated secrets (BR-021-09).
# Never copy it into the repo, and never source it in a development shell.
#
# Compose injects every variable here into web and worker. It therefore holds
# NO migrator credential: those live in migrator.env beside it (template
# scripts/personal/migrator.env.example), which only the scripts read.

NODE_ENV=production

# --- database (its own Compose project and volume; BR-021-06) ------------------
# Host names are the Compose service, not localhost: unusable from a host shell
# by construction, which is one more barrier between a dev shell and this data.
DATABASE_URL=postgresql://allmywallet_app:__APP_PASSWORD__@postgres:5432/allmywallet
PERSONAL_POSTGRES_PORT=55432

# --- web, on loopback only (BR-021-10/11) --------------------------------------
PERSONAL_WEB_PORT=3100
# docker-compose.yml turns this into the containers' AUTH_URL.
PERSONAL_AUTH_URL=http://localhost:3100/api/auth
AUTH_SECRET=__AUTH_SECRET__
# Google Cloud console → OAuth client → authorised redirect URI:
#   http://localhost:3100/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- email (BR-021-34) -----------------------------------------------------------
# Delivery is switched on through the config registry, not here:
#   notifications.email_provider = resend   (deployment level)
RESEND_API_KEY=
EMAIL_FROM=

# --- backups (BR-021-16–19) -------------------------------------------------------
# A directory on a DIFFERENT volume from the Postgres data — an external drive.
BACKUP_DIR=
# `age-keygen -o <somewhere safe, not this laptop>` prints the public key.
BACKUP_AGE_RECIPIENT=
# Where the Docker VM keeps its disk, which is where the Postgres volume lives.
# backup.sh refuses a BACKUP_DIR on the same volume as this path (BR-021-18).
#   Rancher Desktop: "$HOME/Library/Application Support/rancher-desktop"
#   Docker Desktop:  "$HOME/Library/Containers/com.docker.docker"
PGDATA_HOST_PATH=

LOG_LEVEL=info
