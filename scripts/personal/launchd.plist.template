<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPEC-021 BR-021-16/BR-021-23 — runs scripts/personal/start.sh at login and
  daily at 09:00. Installed by scripts/personal/init.sh to
  ~/Library/LaunchAgents/com.allmywallet.personal.plist. Holds no secret: the
  scripts read the env files themselves.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.allmywallet.personal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__START_SCRIPT__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>ALLMYWALLET_ENV_FILE</key>
    <string>__ENV_FILE__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
